---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkshopCard from '../components/WorkshopCard.astro';

const workshops = (await getCollection('workshops')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="סדנאות — הכנת בשמים וקרמיקה"
  description="סדנאות ייחודיות בבוטניקה: הכנת בשמים משמנים אתריים וסדנת קרמיקה ליצירת גאדג'טים למטבח. חוויה יצירתית עם נגיעה טיפולית."
>
  <section class="section container">
    <div class="section-head"><h1>סדנאות ומפגשים</h1></div>
    <div class="workshops-list">
      {workshops.map((workshop) => (
        <WorkshopCard workshop={workshop} headingLevel="h2" />
      ))}
    </div>
  </section>
</Base>

<style>
  /* .div-block-10 rows, stacked with margin-bottom: 48px */
  .workshops-list { display: grid; gap: 48px; }
</style>
