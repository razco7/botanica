---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const plants = await getCollection('flora');
  return plants.map((plant) => ({ params: { slug: plant.id }, props: { plant } }));
}

const { plant } = Astro.props;
const d = plant.data;
const { Content } = await render(plant);

const related = (
  await Promise.all(
    d.similarPlants.map((slug) => getEntry('flora', slug).catch(() => undefined)),
  )
).filter((p): p is NonNullable<typeof p> => Boolean(p));

// facts flow as small label/value pairs, grouped into rows
const facts: [string, string][] = [
  ['חודשי פריחה', d.bloomMonths],
  ['איזור צמיחה טבעי', d.region],
  ['סוג', d.plantType],
  ['חלקי הצמח בשימוש', d.partsUsed],
  ['טעם', d.taste],
].filter((f): f is [string, string] => Boolean(f[1]));

if (related.length) {
  facts.push([
    'צמחים בעלי תכונות דומות',
    related.map((p) => p.data.name).join(', '),
  ]);
}
const factRows = [facts.slice(0, 3), facts.slice(3)].filter((r) => r.length);
---

<Base
  title={`${d.name} — ${d.latinName}`}
  description={d.identification.slice(0, 155)}
  image={d.image}
>
  <section class="section-magdir">
    <div class="magdir">
      <div class="magdir__text">
        <div class="magdir__title">
          <h1>{d.name}</h1>
          <p class="magdir__latin">{d.latinName}</p>
        </div>

        <div class="par">
          <h3>מאפייני זיהוי</h3>
          <p>{d.identification}</p>
        </div>

        <div class="par">
          <h3>פעילות</h3>
          <p>{d.activity}</p>
        </div>

        {d.internalUse.length > 0 && (
          <div class="par">
            <h3>יעיל בשימוש פנימי</h3>
            {d.internalUseNote && <p>{d.internalUseNote}</p>}
            <ul>{d.internalUse.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}

        {d.externalUse.length > 0 && (
          <div class="par">
            <h3>יעיל בשימוש חיצוני</h3>
            {d.externalUseNote && <p>{d.externalUseNote}</p>}
            <ul>{d.externalUse.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}

        {d.sideEffects && (
          <div class="par">
            <h3>{d.sideEffectsLabel}</h3>
            <p>{d.sideEffects}</p>
          </div>
        )}

        <Content />

        {factRows.length > 0 && <div class="magdir__divider"></div>}
        {factRows.map((row) => (
          <div class="fact-row">
            {row.map(([k, v]) => (
              <div class="par">
                <h5>{k}</h5>
                {k === 'צמחים בעלי תכונות דומות' ? (
                  <p>
                    {related.map((p, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={`/flora/${p.id}`}>{p.data.name}</a>
                      </>
                    ))}
                  </p>
                ) : (
                  <p>{v}</p>
                )}
              </div>
            ))}
          </div>
        ))}

        {d.tip && (
          <div class="magdir__tip">
            <span class="magdir__tip-icon" aria-hidden="true">🌿</span>
            <p>{d.tip}</p>
          </div>
        )}
      </div>

      <div class="magdir__image">
        <img src={d.image} alt={d.name} width="900" height="900" />
      </div>
    </div>
  </section>
</Base>

<style>
  .section-magdir {
    width: 100%;
    max-width: var(--maxw);
    margin: 32px auto 120px;
  }

  /* .container-magdir — text (right) + sticky image (left) */
  .magdir {
    direction: rtl;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-inline: var(--gutter);
  }
  @media (max-width: 991px) {
    .magdir { grid-template-columns: 1fr; margin-inline: 32px; }
  }
  @media (max-width: 479px) { .magdir { margin-inline: 12px; } }

  /* .title-magdir-div — sticky white header */
  .magdir__title {
    position: sticky;
    top: 0;
    background: #fff;
    padding: 24px 0 24px;
    margin-bottom: 16px;
    z-index: 1;
  }
  /* .title-magdir */
  .magdir__title h1 { font-size: 64px; line-height: 1.35; margin: 0; color: #222; }
  @media (max-width: 1100px) { .magdir__title h1 { font-size: 48px; line-height: 1.25; } }
  /* .latin-name */
  .magdir__latin { font-size: 20px; line-height: 32px; margin: 0; color: #222; }
  @media (max-width: 767px) { .magdir__title h1 { font-size: 32px; line-height: 44px; } }

  /* .par-magdir — a content block: small label + text */
  .par { color: #222; font-size: 20px; margin-bottom: 32px; }
  .par h3 { font-size: 24px; line-height: 30px; margin: 0 0 8px; }
  .par h5 { font-size: 15px; text-transform: uppercase; opacity: .55; margin: 0 0 4px; font-weight: 700; }
  .par p { margin: 0 0 6px; opacity: .75; line-height: 30px; }
  .par ul { margin: 8px 0 0; padding-inline-start: 1.2em; }
  .par li { opacity: .75; }
  .par li + li { margin-top: 2px; }
  .par a { text-decoration: underline; text-underline-offset: 3px; }

  /* .divider-magdir */
  .magdir__divider { background: var(--line-3); height: 1px; margin: 8px 0 32px; }

  /* .div-block-4 — facts laid out in a row */
  .fact-row { display: flex; justify-content: space-between; gap: 30px; margin-bottom: 8px; }
  .fact-row .par { margin-bottom: 24px; }
  @media (max-width: 479px) { .fact-row { flex-direction: column; gap: 0; } }

  /* .tip */
  .magdir__tip {
    display: flex;
    gap: 12px;
    background: var(--bg-sand);
    padding: 18px 20px;
    border-radius: var(--radius);
    margin-top: 8px;
  }
  .magdir__tip-icon { font-size: 20px; line-height: 1.4; }
  .magdir__tip p { margin: 0; line-height: 28px; }

  /* .image-3 — sticky, tracks the scroll (cell stretches to the text column height) */
  .magdir__image img {
    position: sticky;
    top: 10vh;
    width: 100%;
    border-radius: var(--radius-card);
  }
  @media (max-width: 991px) {
    .magdir__image { order: -1; }
    .magdir__image img { position: static; max-height: 60vh; object-fit: contain; }
    .magdir__title { position: static; }
  }
</style>
