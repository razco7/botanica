---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const plants = (await getCollection('flora')).sort((a, b) =>
    (a.data.shortName ?? a.data.name).localeCompare(b.data.shortName ?? b.data.name, 'he'),
  );
  return plants.map((plant, i) => ({
    params: { slug: plant.id },
    props: {
      plant,
      prev: plants[i - 1] ?? null,
      next: plants[i + 1] ?? null,
    },
  }));
}

const { plant, prev, next } = Astro.props;
const d = plant.data;
const { Content } = await render(plant);
const label = (p: typeof plant) => p.data.shortName ?? p.data.name;

// facts flow as small label/value pairs, grouped into rows
const facts: [string, string][] = [
  ['חודשי פריחה', d.bloomMonths],
  ['איזור צמיחה טבעי', d.region],
  ['סוג', d.plantType],
  ['חלקי הצמח בשימוש', d.partsUsed],
  ['טעם', d.taste],
].filter((f): f is [string, string] => Boolean(f[1]));

const factRows = [facts.slice(0, 3), facts.slice(3)].filter((r) => r.length);
---

<Base
  title={`${d.name} — ${d.latinName}`}
  description={d.identification.slice(0, 155)}
  image={d.image}
>
  <section class="section-magdir">
    <div class="magdir">
      <div class="magdir__text">
        <a href="/flora-index" class="magdir__back">→ חזרה למגדיר הצמחים</a>

        <div class="magdir__title">
          <h1>{d.name}</h1>
          <p class="magdir__latin">{d.latinName}</p>
        </div>

        <div class="par">
          <h3>מאפייני זיהוי</h3>
          <p>{d.identification}</p>
        </div>

        <div class="par">
          <h3>פעילות</h3>
          <p>{d.activity}</p>
        </div>

        {d.internalUse.length > 0 && (
          <div class="par">
            <h3>יעיל בשימוש פנימי</h3>
            {d.internalUseNote && <p>{d.internalUseNote}</p>}
            <ul>{d.internalUse.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}

        {d.externalUse.length > 0 && (
          <div class="par">
            <h3>יעיל בשימוש חיצוני</h3>
            {d.externalUseNote && <p>{d.externalUseNote}</p>}
            <ul>{d.externalUse.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}

        {d.sideEffects && (
          <div class="par">
            <h3>{d.sideEffectsLabel}</h3>
            <p>{d.sideEffects}</p>
          </div>
        )}

        <Content />

        {factRows.length > 0 && <div class="magdir__divider"></div>}
        {factRows.map((row) => (
          <div class="fact-row">
            {row.map(([k, v]) => (
              <div class="par">
                <h5>{k}</h5>
                <p>{v}</p>
              </div>
            ))}
          </div>
        ))}

        {d.tip && (
          <div class="magdir__tip">
            <svg class="magdir__tip-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path fill="#222" d="M10 20C8.78333 19.85 7.575 19.5208 6.375 19.0125C5.175 18.5042 4.10417 17.775 3.1625 16.825C2.22083 15.875 1.45833 14.675 0.875 13.225C0.291667 11.775 0 10.0333 0 8V7H1C1.85 7 2.725 7.10833 3.625 7.325C4.525 7.54167 5.36667 7.86667 6.15 8.3C6.35 6.86667 6.80417 5.39583 7.5125 3.8875C8.22083 2.37917 9.05 1.08333 10 0C10.95 1.08333 11.7792 2.37917 12.4875 3.8875C13.1958 5.39583 13.65 6.86667 13.85 8.3C14.6333 7.86667 15.475 7.54167 16.375 7.325C17.275 7.10833 18.15 7 19 7H20V8C20 10.0333 19.7083 11.775 19.125 13.225C18.5417 14.675 17.7792 15.875 16.8375 16.825C15.8958 17.775 14.8292 18.5042 13.6375 19.0125C12.4458 19.5208 11.2333 19.85 10 20ZM9.95 17.95C9.76667 15.1833 8.94583 13.0917 7.4875 11.675C6.02917 10.2583 4.21667 9.38333 2.05 9.05C2.23333 11.9 3.07917 14.025 4.5875 15.425C6.09583 16.825 7.88333 17.6667 9.95 17.95ZM10 11.6C10.25 11.2333 10.5542 10.8542 10.9125 10.4625C11.2708 10.0708 11.6167 9.73333 11.95 9.45C11.9167 8.5 11.7292 7.50833 11.3875 6.475C11.0458 5.44167 10.5833 4.43333 10 3.45C9.41667 4.43333 8.95417 5.44167 8.6125 6.475C8.27083 7.50833 8.08333 8.5 8.05 9.45C8.38333 9.73333 8.73333 10.0708 9.1 10.4625C9.46667 10.8542 9.76667 11.2333 10 11.6ZM11.95 17.5C12.5667 17.3 13.2083 17.0083 13.875 16.625C14.5417 16.2417 15.1625 15.7208 15.7375 15.0625C16.3125 14.4042 16.8042 13.5833 17.2125 12.6C17.6208 11.6167 17.8667 10.4333 17.95 9.05C16.3833 9.28333 15.0083 9.80417 13.825 10.6125C12.6417 11.4208 11.7333 12.45 11.1 13.7C11.3 14.2333 11.4708 14.8167 11.6125 15.45C11.7542 16.0833 11.8667 16.7667 11.95 17.5Z"/>
            </svg>
            <p>{d.tip}</p>
          </div>
        )}
      </div>

      <div class="magdir__image">
        <img src={d.image} alt={d.name} width="900" height="900" />
      </div>
    </div>

    {(prev || next) && (
      <nav class="magdir__nav" aria-label="ניווט בין צמחים">
        {prev ? (
          <a href={`/flora/${prev.id}`} class="magdir__nav-link">
            <span class="magdir__nav-dir">→ הצמח הקודם</span>
            <span class="magdir__nav-name">{label(prev)}</span>
          </a>
        ) : <span />}
        {next ? (
          <a href={`/flora/${next.id}`} class="magdir__nav-link magdir__nav-link--next">
            <span class="magdir__nav-dir">הצמח הבא ←</span>
            <span class="magdir__nav-name">{label(next)}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </section>
</Base>

<style>
  .section-magdir {
    width: 100%;
    max-width: var(--maxw);
    margin: 32px auto 120px;
  }

  /* .container-magdir — text (right) + sticky image (left) */
  .magdir {
    direction: rtl;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-inline: var(--gutter);
  }
  @media (max-width: 991px) {
    .magdir { grid-template-columns: 1fr; margin-inline: 32px; }
  }
  @media (max-width: 479px) { .magdir { margin-inline: 12px; } }

  .magdir__back {
    display: inline-block;
    margin-top: 24px;
    font-size: 16px;
    opacity: 0.6;
  }
  .magdir__back:hover { opacity: 1; }

  /* prev / next */
  .magdir__nav {
    direction: rtl;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-inline: var(--gutter);
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--line-3);
  }
  .magdir__nav-link { display: grid; gap: 4px; }
  .magdir__nav-link--next { text-align: left; }
  .magdir__nav-dir { font-size: 15px; opacity: 0.6; }
  .magdir__nav-name { font-size: 22px; font-weight: 700; }
  .magdir__nav-link:hover .magdir__nav-name { color: var(--accent); }
  @media (max-width: 991px) { .magdir__nav { margin-inline: 32px; } }
  @media (max-width: 479px) { .magdir__nav { margin-inline: 12px; } }

  /* .title-magdir-div — sticky white header */
  .magdir__title {
    position: sticky;
    top: 0;
    background: #fff;
    padding: 24px 0 24px;
    margin-bottom: 16px;
    z-index: 1;
  }
  /* .title-magdir */
  .magdir__title h1 { font-size: 64px; line-height: 1.35; margin: 0; color: #222; }
  @media (max-width: 1100px) { .magdir__title h1 { font-size: 48px; line-height: 1.25; } }
  /* .latin-name */
  .magdir__latin { font-size: 20px; line-height: 32px; margin: 0; color: #222; }
  @media (max-width: 767px) { .magdir__title h1 { font-size: 32px; line-height: 44px; } }

  /* .par-magdir — a content block: small label + text */
  .par { color: #222; font-size: 20px; margin-bottom: 32px; }
  .par h3 { font-size: 24px; line-height: 30px; margin: 0 0 8px; }
  .par h5 { font-size: 15px; text-transform: uppercase; opacity: .55; margin: 0 0 4px; font-weight: 700; }
  .par p { margin: 0 0 6px; opacity: .75; line-height: 30px; }
  .par ul { margin: 8px 0 0; padding-inline-start: 1.2em; }
  .par li { opacity: .75; }
  .par li + li { margin-top: 2px; }
  .par a { text-decoration: underline; text-underline-offset: 3px; }

  /* .divider-magdir */
  .magdir__divider { background: var(--line-3); height: 1px; margin: 8px 0 32px; }

  /* .div-block-4 — facts laid out in a row */
  .fact-row { display: flex; justify-content: space-between; gap: 30px; margin-bottom: 8px; }
  .fact-row .par { margin-bottom: 24px; }
  @media (max-width: 479px) { .fact-row { flex-direction: column; gap: 0; } }

  /* .tip */
  .magdir__tip {
    display: inline-flex;
    gap: 8px;
    background: #f7f7f7;
    padding: 12px 14px;
    border-radius: 8px;
    margin-top: 40px;
    font-size: 20px;
  }
  .magdir__tip-icon { flex: none; margin-top: 5px; }
  .magdir__tip p { margin: 0; line-height: 28px; }

  /* .image-3 — sticky, tracks the scroll (cell stretches to the text column height) */
  .magdir__image img {
    position: sticky;
    top: 10vh;
    width: 100%;
    border-radius: var(--radius-card);
  }
  @media (max-width: 991px) {
    .magdir__image { order: -1; }
    .magdir__image img { position: static; max-height: 60vh; object-fit: contain; }
    .magdir__title { position: static; }
  }
</style>
