---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories } from '../../data/site';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="חנות בוטניקה — שמנים, פרחי באך וקרמיקה"
  description="חנות בוטניקה: שמנים ארומתרפיים טיפוליים, תמציות פרחי באך וכלי קרמיקה בעבודת יד — בהתאמה אישית."
>
  <section class="section">
    <div class="container">
      <div class="section-head"><h1>המוצרים שלנו</h1></div>

      <div class="store-filter" role="tablist" aria-label="סינון לפי קטגוריה">
        <button class="filter-tab is-active" data-filter="all" aria-pressed="true">כל המוצרים</button>
        {categories.map((c) => (
          <button class="filter-tab" data-filter={c.slug} aria-pressed="false">{c.label}</button>
        ))}
      </div>

      <div class="store-grid" id="store-grid">
        {products.map((product) => (
          <div class="store-grid__item" data-category={product.data.category}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* .magdir-categories — plain text tabs, centered */
  .store-filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem 2rem;
    margin-bottom: 40px;
  }
  .filter-tab {
    font: inherit;
    font-size: 18px;
    padding: 6px 2px;
    border: 0;
    background: none;
    color: var(--ink);
    opacity: 0.6;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .filter-tab:hover { opacity: 0.9; }
  .filter-tab.is-active { opacity: 1; font-weight: 700; }

  .store-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .store-grid__item[hidden] { display: none; }

  @media (max-width: 767px) { .store-grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
  @media (max-width: 479px) { .store-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.store-filter .filter-tab');
  const items = document.querySelectorAll<HTMLElement>('.store-grid__item');

  function apply(filter: string) {
    items.forEach((el) => {
      el.hidden = filter !== 'all' && el.dataset.category !== filter;
    });
    chips.forEach((c) => {
      const active = c.dataset.filter === filter;
      c.classList.toggle('is-active', active);
      c.setAttribute('aria-pressed', String(active));
    });
    const url = new URL(location.href);
    if (filter === 'all') url.searchParams.delete('c');
    else url.searchParams.set('c', filter);
    history.replaceState(null, '', url);
  }

  chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter!)));

  const initial = new URL(location.href).searchParams.get('c');
  if (initial) apply(initial);
</script>
