---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories, categoryLabel } from '../../data/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return categories.map((c) => ({
    params: { category: c.slug },
    props: {
      label: c.label,
      items: products
        .filter((p) => p.data.category === c.slug)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { category } = Astro.params;
const { label, items } = Astro.props;
---

<Base
  title={`${label} — חנות בוטניקה`}
  description={`${label} של בוטניקה — בעבודת יד ובהתאמה אישית.`}
>
  <section class="section">
    <div class="container">
      <nav class="crumbs"><a href="/store">החנות</a> / {label}</nav>
      <div class="section-head"><h1>{label}</h1></div>

      <div class="cat-tabs">
        <a href="/store">כל המוצרים</a>
        {categories.map((c) => (
          <a href={`/store/${c.slug}`} aria-current={c.slug === category ? 'page' : undefined}>
            {c.label}
          </a>
        ))}
      </div>

      <div class="store-grid">
        {items.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { color: var(--ink-faint); font-size: 15px; margin-bottom: 1rem; }
  .cat-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 2rem;
    margin-bottom: 40px;
    font-size: 18px;
  }
  .cat-tabs a { opacity: 0.6; padding-block: 0.3em; }
  .cat-tabs a:hover { opacity: 0.9; }
  .cat-tabs a[aria-current='page'] { opacity: 1; font-weight: 700; }
  .store-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  @media (max-width: 767px) { .store-grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
  @media (max-width: 479px) { .store-grid { grid-template-columns: 1fr; } }
</style>
