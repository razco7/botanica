---
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';
---

<Base title="ההזמנה התקבלה" description="תודה על ההזמנה.">
  <section class="section container narrow text-center">
    <h1>תודה על ההזמנה! 🌿</h1>
    <p class="prose">
      התשלום התקבל ואישור תשלום נשלח אליכם במייל מ־PayPal.
      הקבלה תימסר לכם באיסוף.
      <span id="order-id"></span>
    </p>
    <p class="prose">
      האיסוף הוא מהקליניקה בחדרה (אפיקי מים 1). <strong>יש לתאם איסוף מראש</strong> —
      התקשרו <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      או כתבו ל־<a href={`mailto:${contact.email}`}>{contact.email}</a> עם מספר ההזמנה.
    </p>
    <p style="margin-top: 2rem"><a href="/store" class="btn">חזרה לחנות</a></p>
  </section>
</Base>

<style>
  .narrow { max-width: 620px; margin-inline: auto; }
  .narrow .prose a { text-decoration: underline; text-underline-offset: 3px; }
  #order-id { display: block; margin-top: 0.5em; opacity: 0.6; font-size: 0.9em; }
</style>

<script>
  import { clearCart } from '../lib/cart';
  clearCart();
  const id = new URLSearchParams(location.search).get('id');
  if (id) {
    const el = document.getElementById('order-id');
    if (el) el.textContent = `מספר הזמנה: ${id}`;
  }
</script>
