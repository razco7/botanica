---
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';
---

<Base title="ההזמנה התקבלה" description="תודה על ההזמנה." noindex>
  <section class="section container narrow text-center">
    <h1>תודה על ההזמנה! 🌿</h1>

    <p class="order-ref" id="order-ref" hidden>
      מספר הזמנה: <strong id="order-n"></strong>
    </p>

    <div class="order-box" id="order-box" hidden>
      <ul id="order-items"></ul>
      <p class="order-total">סה״כ ששולם: <strong id="order-total"></strong></p>
    </div>

    <p class="prose">
      התשלום התקבל ואישור נשלח אליכם במייל. הקבלה תימסר לכם באיסוף.
    </p>
    <p class="prose">
      האיסוף מהקליניקה בחדרה (אפיקי מים 1). <strong>יש לתאם איסוף מראש</strong> —
      התקשרו <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>{' '}
      או כתבו ל־<a href={`mailto:${contact.email}`}>{contact.email}</a>{' '}
      עם מספר ההזמנה.
    </p>

    <p class="order-id" id="order-id" hidden></p>
    <p style="margin-top: 2rem"><a href="/store" class="btn">חזרה לחנות</a></p>
  </section>
</Base>

<style>
  .narrow { max-width: 620px; margin-inline: auto; }
  .narrow .prose a { text-decoration: underline; text-underline-offset: 3px; }
  .order-ref { font-size: 20px; margin: 0.5em 0 1em; }
  .order-ref strong { font-size: 26px; letter-spacing: 0.06em; }

  .order-box {
    text-align: right;
    background: #f7f7f7;
    border-radius: var(--radius-card);
    padding: 20px 22px;
    margin: 0 0 1.75rem;
  }
  .order-box ul { list-style: none; margin: 0; padding: 0; }
  .order-box li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    font-size: 16px;
  }
  .order-box li + li { border-top: 1px solid #e6e6e6; }
  .order-box .order-total {
    margin: 12px 0 0;
    padding-top: 12px;
    border-top: 2px solid #ddd;
    display: flex;
    justify-content: space-between;
    font-size: 18px;
  }

  .order-id { opacity: 0.45; font-size: 13px; margin-top: 1.5em; }
</style>

<script>
  import { clearCart } from '../lib/cart';
  clearCart();

  const money = (n: number) => `₪ ${n.toFixed(2)}`;
  const params = new URLSearchParams(location.search);
  const n = params.get('n');
  const id = params.get('id');

  if (n) {
    document.getElementById('order-n')!.textContent = n;
    (document.getElementById('order-ref') as HTMLElement).hidden = false;
  }
  if (id) {
    const el = document.getElementById('order-id')!;
    el.textContent = `אסמכתת PayPal: ${id}`;
    (el as HTMLElement).hidden = false;
  }

  try {
    const raw = sessionStorage.getItem('botanica-last-order');
    if (raw) {
      const o = JSON.parse(raw);
      if (o && o.ref === n && Array.isArray(o.items) && o.items.length) {
        const list = document.getElementById('order-items')!;
        list.innerHTML = o.items
          .map((it: any) => {
            const name = it.variant ? `${it.name} (${it.variant})` : it.name;
            return `<li><span>${name} × ${it.qty}</span><span>${money(
              it.price * it.qty,
            )}</span></li>`;
          })
          .join('');
        document.getElementById('order-total')!.textContent = money(o.total);
        (document.getElementById('order-box') as HTMLElement).hidden = false;
      }
      sessionStorage.removeItem('botanica-last-order');
    }
  } catch {
    /* ignore */
  }
</script>
