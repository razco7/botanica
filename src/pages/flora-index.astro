---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PlantCard from '../components/PlantCard.astro';

const plants = (await getCollection('flora')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'he'),
);
---

<Base
  title="מגדיר צמחי מרפא"
  description="מגדיר צמחי המרפא של בוטניקה — מאפייני זיהוי, פעילות, שימוש פנימי וחיצוני, ותופעות לוואי. לבנדר, אשווגנדה, תלתן ועוד."
>
  <section class="section container">
    <div class="section-head"><h1>מגדיר צמחים</h1></div>
    <div class="flora-grid">
      {plants.map((plant) => <PlantCard plant={plant} />)}
    </div>
  </section>
</Base>

<style>
  /* .grid-magdir — 3 across (bump to repeat(4, 1fr) when more entries are added) */
  .flora-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  @media (max-width: 991px) { .flora-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 479px) { .flora-grid { grid-template-columns: 1fr; } }
</style>
