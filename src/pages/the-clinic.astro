---
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';

const methods = [
  {
    title: 'טיפול בצמחי מרפא',
    image: '/images/site/herbs.avif',
    paras: [
      'השימוש בצמחי מרפא הוא אחת מצורות הרפואה העתיקות בעולם. מהרפואה הסינית המסורתית, דרך האיורוודה ההודית ועד הרפואה האירופאית המסורתית — כולן התבססו במשך אלפי שנים על צמחים לטיפול במחלות, להקלה על תסמינים ולחיזוק הבריאות הכללית. גם היום חלק גדול מהתרופות המודרניות פותחו בהשראת חומרים פעילים שהתגלו בצמחים.',
      'ברפואת הצמחים המודרנית נעשה שימוש מושכל בצמחים בהתאם לידע מסורתי ולמחקר מדעי עדכני. הצמחים יכולים להשפיע על מערכות שונות בגוף, כגון מערכת העיכול, מערכת העצבים, מערכת החיסון, מערכת הנשימה והמערכת ההורמונלית.',
      'את צמחי המרפא ניתן לצרוך בכמה צורות הכנה, בהתאם לחומרים הפעילים בצמח ולמטרת הטיפול: חליטות ומרתחים, טינקטורות (תמציות אלכוהוליות מרוכזות), תמציות יבשות בכמוסות, אבקות צמח, וכן שמנים מושרים או משחות לשימוש חיצוני.',
      'טיפול בצמחי מרפא מתבצע בדרך כלל באמצעות פורמולה — שילוב של מספר צמחים בעלי פעולה משלימה. השילוב מאפשר להשפיע על כמה מנגנונים בגוף במקביל ולהגביר את האפקט הטיפולי, תוך צמצום תופעות לוואי אפשריות.',
      'אני מוצאת בצמחי מרפא כלי טיפולי עמוק ומדויק, המאפשר להתאים לכל אדם פורמולה אישית בהתאם למצבו הבריאותי והרגשי. הטיפול אינו מתמקד רק בהקלה על סימפטומים, אלא בשורש הבעיה — תוך תמיכה במנגנוני האיזון הטבעיים של הגוף.',
    ],
  },
  {
    title: 'טיפול בפטריות מרפא',
    image: '/images/site/mushrooms.avif',
    paras: [
      'פטריות מרפא הן קבוצה מיוחדת של פטריות בעלות שימוש מסורתי ברפואה הטבעית מזה אלפי שנים. הן נפוצות במיוחד ברפואות המסורתיות של מזרח אסיה, שם נעשה בהן שימוש לחיזוק הבריאות הכללית, לשיפור החיוניות ולתמיכה במערכות גוף שונות. בשנים האחרונות הן זוכות לעניין מחקרי הולך וגובר.',
      'הפטריות נחשבות אדפטוגניות — הן אינן פועלות בדרך כלל על סימפטום בודד, אלא מסייעות לאיזון ולוויסות של מערכות שונות בגוף. מסיבה זו הן משולבות לעיתים קרובות בטיפול במצבים כרוניים או בתמיכה במצבים שבהם יש צורך בחיזוק כללי.',
      'פטריות מרפא יכולות לתמוך במגוון תחומים: חיזוק מערכת החיסון, תמיכה במערכת העצבים במצבי סטרס, קשיי ריכוז, עייפות או ירידה באנרגיה; איזון רמות סוכר ושומנים בדם; שיפור תפקוד מערכת העיכול והכבד; ותמיכה במערכת הלב וכלי הדם.',
      'בדומה לצמחי מרפא, גם פטריות מרפא מותאמות בדרך כלל באופן אישי. לעיתים משלבים כמה פטריות יחד כדי ליצור השפעה רחבה ומאוזנת יותר. הטיפול נעשה באמצעות תמציות מרוכזות המאפשרות ספיגה נוחה ושימוש יומיומי פשוט, ומתאים גם לילדים.',
      'אני רואה בפטריות המרפא כלי טיפולי מדויק ועדין — כזה שפועל לאורך זמן, מחזק מבפנים ותומך בתהליכי ריפוי טבעיים מבלי להעמיס על הגוף.',
    ],
  },
  {
    title: 'טיפול בארומתרפיה',
    image: '/images/site/aromatherapy.jpg',
    paras: [
      'המילה "ארומתרפיה" נגזרת מהשילוב של "ארומה" (ניחוח) ו"תרפיה" (טיפול), ומתייחסת לטיפול בגוף ובנפש באמצעות ריחות. השיטה עושה שימוש בשמנים אתריים ובשמני בסיס המופקים מפרחים, מצמחי מרפא, מתבלינים, משורשים ומעצים.',
      'שמנים ארומתרפיים הם תמצית של החומרים הפעילים, ולכן הם מרוכזים מאוד.',
      'אני מוצאת בארומתרפיה פתרון מצוין לריפוי, במיוחד מפני שהיא פשוטה וקלת יישום (גם על ילדים). אפשר למרוח את השמנים על העור או להדיף אותם באוויר.',
      'בנוסף ליתרונות הרפואיים והנפשיים, יש לארומתרפיה גם צד אנרגטי שאפשר להיעזר בו לטיפול בפן המנטלי.',
    ],
  },
  {
    title: 'טיפול בפרחי באך',
    image: '/images/site/bach.jpg',
    paras: [
      'שיטת הטיפול בפרחי באך פותחה על ידי ד"ר אדוארד באך בשנת 1936. השיטה מתמקדת בטיפול במצבים רגשיים כבסיס לריפוי פיזי.',
      'ד"ר באך — רופא, מדען ובקטריולוג הומיאופת — מיין טיפוסים ומצבים נפשיים שונים שמהם סובלים אנשים, והתאים להם 38 תמציות פרחים המסייעות לאיזון רגשי ולריפוי. התמציות, המיוצרות עד היום בשיטה המקורית, עוזרות בשחרור רגשות שליליים וחסמים מנטליים, תורמות להתמודדות עם מצבי לחץ, חרדה, פחד וטראומות, ומסייעות בריפוי הנפש דרך איזון אנרגיה וחיזוק כוח החיים הפנימי.',
      'מכיוון שמדובר בטיפול אנרגטי, פרחי באך יכולים להתאים לכולם: תינוקות, ילדים, נשים בהריון, מבוגרים בגיל השלישי — ואף בעלי חיים.',
    ],
  },
];
---

<Base
  title="הקליניקה של פזית — הרבליסטית קלינית"
  description="קליניקה לרפואה משלימה. טיפול באמצעות פטריות מרפא, פרחי באך, ארומתרפיה וצמחי מרפא. לקביעת תור: 052-8717501"
>
  <section class="section">
    <div class="container clinic-intro">
      <div class="clinic-intro__photo">
        <img src="/images/site/pazit.jpeg" alt="פזית הרנוי כהן בקליניקה" width="620" height="760" />
      </div>
      <div class="clinic-intro__text">
        <h1 class="clinic-h1">על הקליניקה</h1>
        <div class="clinic-prose">
          <p>הי, שמי פזית הרנוי כהן, נשואה ואמא לשניים, הרבליסטית קלינית ומטפלת בפטריות מרפא. בקליניקה אני משלבת טיפול בצמחי מרפא, פטריות מרפא, ארומתרפיה ופרחי באך יחד עם המלצות לתזונה תומכת ושיח קשוב.</p>
          <p>כששאלו אותי מה אני רוצה לעשות כשאהיה גדולה, תמיד עניתי שאני רוצה להיות רופאה, כמו אבא שלי. אבל כשהגיע הזמן לבחור הייתי חצויה בין עולם היצירה לעולם הרפואה, ובחרתי ללמוד עיצוב גרפי. עולם העיצוב מרתק ומהנה, אבל הרגשתי שאין לי בו מימוש — חיפשתי איך אני יכולה לעזור לאנשים ולא מצאתי שם את התשובה.</p>
          <p>את עולם רפואת הצמחים גיליתי כשחיפשתי פתרון לבעיה רפואית אישית, וכשלא מצאתי לה מענה ברפואה הקונבנציונלית התחלתי לחקור. פתאום נחשפתי למושגים כמו הרבליזם, פטריות מרפא ושמנים אתריים. כבת לאבא רופא ולאמא רוקחת, לא ידעתי שקיים עולם שלם של ידע עתיק עם פתרונות לכל כך הרבה דברים.</p>
          <p>בכל יום שעובר אני מעמיקה עוד בעולם הקסום הזה של הטבע, שטומן בחובו רפואה שלמה.</p>
          <p>ליצירת קשר, לייעוץ או לטיפול התקשרו <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a> או פנו דרך <a href="/contact">טופס יצירת הקשר</a>.</p>
        </div>
        <a href="/contact" class="btn" style="margin-top: 1.6rem">לקביעת תור</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2 class="clinic-h1 clinic-methods__head">שיטות הטיפול בקליניקה</h2>
    <div class="methods">
      {methods.map((m) => (
        <article class="method">
          <img class="method__img" src={m.image} alt={m.title} loading="lazy" width="720" height="360" />
          <h3 class="method__title">{m.title}</h3>
          <div class="method__body">
            {m.paras.map((p) => <p>{p}</p>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  /* .heading-4 — section title on this page */
  .clinic-h1 { font-size: 54px; line-height: 68px; font-weight: 700; margin: 0 0 0.4em; }
  @media (max-width: 991px) { .clinic-h1 { font-size: 48px; line-height: 60px; } }
  @media (max-width: 767px) { .clinic-h1 { font-size: 40px; line-height: 50px; } }

  /* .about-div — image (right) + text (left), two equal columns */
  .clinic-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .clinic-intro__photo img {
    width: 100%;
    border-radius: 16px;
    object-fit: cover;
  }
  /* .paragraph-2 */
  .clinic-prose { font-size: 20px; line-height: 28px; }
  .clinic-prose > p { margin: 0 0 20px; }
  .clinic-prose a { text-decoration: underline; text-underline-offset: 3px; }

  .clinic-methods__head { text-align: center; margin-bottom: 32px; }

  /* .div-block-3 — two-column grid of stacked cards */
  .methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px 32px;
    align-items: start;
  }
  /* .image-2 — wide banner image */
  .method__img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 16px;
  }
  /* .heading-6 */
  .method__title { font-size: 32px; line-height: 44px; font-weight: 700; margin: 12px 0 8px; }
  /* .paragraph-3 */
  .method__body { font-size: 18px; line-height: 1.6; }
  .method__body p { margin: 0 0 1em; }
  .method__body p:last-child { margin-bottom: 0; }

  @media (max-width: 991px) {
    .clinic-intro { grid-template-columns: 1fr; gap: 24px; }
    .clinic-intro__photo { max-width: 480px; }
  }
  @media (max-width: 767px) {
    .methods { grid-template-columns: 1fr; }
  }
</style>
