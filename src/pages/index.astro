---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import WorkshopCard from '../components/WorkshopCard.astro';
import { promo } from '../data/site';

const products = await getCollection('products');
const latest = products
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const workshops = (await getCollection('workshops')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="בוטניקה | טיפול בצמחי מרפא, פרחי באך וארומתרפיה"
  bareTitle
  description="קליניקה וחנות אינטרנטית לרפואה משלימה בחדרה. טיפול בפרחי באך, ארומתרפיה, צמחי מרפא, סדנאות, מגדיר צמחים."
>
  {promo.enabled && (
    <div class="top-section">
      <div
        class="intro-header"
        style={`background-image: linear-gradient(rgba(0,0,0,.3), rgba(0,0,0,.3)), url(${promo.image})`}
      >
        <div class="intro-content">
          <div class="h-jumbo">{promo.title}</div>
          <p class="promo-sub">{promo.subtitle}</p>
          <a href={promo.ctaHref} class="btn btn--white">{promo.ctaLabel}</a>
        </div>
      </div>
    </div>
  )}

  <div class="top-section">
    <div
      class="intro-header"
      style="background-image: linear-gradient(rgba(0,0,0,.3), rgba(0,0,0,.3)), url(/images/site/hero-botanic.jpg)"
    >
      <div class="intro-content">
        <div class="intro-text">
          <h1 class="h-jumbo">ברוכים הבאים לבוטניקה</h1>
          <p class="intro-lead">
            כאן באתר אני משלבת את כל האהבות שלי: טיפול טבעי, אהבת צמחים, יצירה ועיצוב.
            תוכלו לקבוע תור לייעוץ ולטיפול בקליניקה שלי, ולמצוא מגוון מוצרים שאני מכינה
            בעצמי — שמנים טיפוליים, פורמולות פרחי באך, בשמים טבעיים, וכן סדנאות שאני
            מארחת וכלי קרמיקה שאני מייצרת בסדנא.
          </p>
        </div>
        <div class="intro-cta">
          <a href="/contact" class="btn btn--white">לחצו לקביעת תור</a>
          <a href="/the-clinic" class="intro-link">לקריאה על הקליניקה ושיטות הטיפול</a>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <div class="section-head">
      <h2 class="h-section">מוצרים אחרונים שנוספו</h2>
    </div>
    <div class="home-products">
      {latest.map((product) => <ProductCard product={product} />)}
    </div>
    <p class="text-center" style="margin-top: 48px">
      <a href="/store" class="btn">לכל המוצרים בחנות</a>
    </p>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2 class="h-section">סדנאות טיפוליות</h2>
    </div>
    <div class="home-workshops">
      {workshops.map((workshop) => (
        <WorkshopCard workshop={workshop} variant="compact" />
      ))}
    </div>
  </section>
</Base>

<style>
  /* .top-section-pazit — contained band around the hero card */
  .top-section {
    max-width: var(--maxw);
    margin: 32px auto 0;
    padding-inline: var(--gutter);
  }
  @media (max-width: 991px) { .top-section { padding-inline: 0; margin-inline: 32px; } }
  @media (max-width: 767px) { .top-section { margin-inline: 15px; } }

  /* .intro-header — rounded hero card with image + dark overlay */
  .intro-header {
    color: #fff;
    background-color: var(--bg-soft);
    background-position: 0 0, 50%;
    background-repeat: repeat, no-repeat;
    background-size: auto, cover;
    border-radius: var(--radius-card);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 540px;
    margin-bottom: 100px;
    padding: 64px 0;
  }
  @media (max-width: 991px) {
    .intro-header { border-radius: 0; margin-bottom: 60px; min-height: 460px; }
  }

  .intro-content { text-align: center; width: 80%; max-width: 1150px; }
  .intro-text { width: 80%; margin: 0 auto 35px; }
  .intro-cta { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  @media (max-width: 991px) { .intro-content { width: 90%; } .intro-text { width: auto; } }

  .h-jumbo { color: #fff; }
  /* .text-block-6 */
  .intro-lead { font-size: 24px; line-height: 34px; margin: 0; }
  @media (max-width: 767px) { .intro-lead { font-size: 18px; line-height: 28px; } }

  .intro-link {
    display: inline-block;
    color: #fff;
    font-size: 18px;
    line-height: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
    padding-bottom: 2px;
  }
  .intro-link:hover { border-color: #fff; }

  .promo-sub { font-size: 18px; margin: 0 0 22px; }

  /* homepage grids */
  .home-products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  /* .workshop-front — two text blocks side by side */
  .home-workshops {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    direction: rtl;
  }

  @media (max-width: 991px) {
    .home-products { grid-template-columns: 1fr 1fr; }
    .home-workshops { grid-template-columns: 1fr; gap: 60px; }
  }
  @media (max-width: 560px) { .home-products { grid-template-columns: 1fr; } }
</style>
