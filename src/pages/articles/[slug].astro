---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, author, contact } from '../../data/site';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter(
    (a) => import.meta.env.DEV || !a.data.draft,
  );
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const d = article.data;
const { Content } = await render(article);

const pageUrl = `${site.url}/articles/${article.id}/`;
const published = d.pubDate.toISOString();
const modified = (d.updatedDate ?? d.pubDate).toISOString();
const dateLabel = d.pubDate.toLocaleDateString('he-IL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const ogImage = d.image ?? site.ogImage;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  image: new URL(ogImage, site.url).href,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'he',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  author: {
    '@type': 'Person',
    name: author.name,
    jobTitle: author.jobTitle,
    url: new URL(author.url, site.url).href,
    image: new URL(author.image, site.url).href,
    worksFor: { '@type': 'HealthAndBeautyBusiness', '@id': `${site.url}/#business` },
    sameAs: [contact.instagram],
  },
  publisher: { '@type': 'HealthAndBeautyBusiness', '@id': `${site.url}/#business` },
};
---

<Base title={d.title} description={d.description} image={ogImage} noindex={d.draft}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />

  <article class="section container article">
    <a href="/articles/" class="article__back">→ חזרה למאמרים</a>

    <header class="article__head">
      <h1>{d.title}</h1>
      <p class="article__byline">
        מאת <a href="/the-clinic/">{author.name}</a> · {author.jobTitle}
        <span class="article__sep">·</span>
        <time datetime={published}>{dateLabel}</time>
      </p>
    </header>

    {d.image && (
      <img class="article__lead" src={d.image} alt="" width="1120" height="620" />
    )}

    <div class="prose article__body">
      <Content />
    </div>

    <aside class="article__cta">
      <p>יש לכם שאלה על צמחי מרפא, או שאתם מחפשים ליווי אישי?</p>
      <a href="/contact/" class="btn">לקביעת פגישת ייעוץ</a>
    </aside>
  </article>
</Base>

<style>
  .article { max-width: 760px; }
  .article__back {
    display: inline-block;
    margin-bottom: 24px;
    color: var(--ink-soft);
    font-size: 15px;
  }
  .article__back:hover { color: var(--ink); }

  .article__head { margin-bottom: 32px; }
  .article__head h1 {
    font-size: 42px;
    line-height: 1.2;
    margin-bottom: 14px;
  }
  .article__byline { font-size: 15px; color: var(--ink-faint); margin: 0; }
  .article__byline a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: 2px; }
  .article__byline a:hover { color: var(--ink); }
  .article__sep { margin-inline: 4px; }

  .article__lead {
    display: block;
    width: 100%;
    border-radius: var(--radius-card);
    margin-bottom: 36px;
  }

  .article__body { font-size: 19px; line-height: 32px; display: flow-root; }
  .article__body :global(h2) {
    font-size: 27px;
    line-height: 1.3;
    margin-top: 1.8em;
    clear: both; /* start each plant section below the previous floated photo */
  }
  .article__body :global(ul) { padding-inline-start: 1.3em; }
  .article__body :global(li + li) { margin-top: 0.3em; }
  .article__body :global(a) { text-decoration: underline; text-underline-offset: 3px; }

  /* plant photos — cutouts on white. On wide screens they float beside the
     prose, alternating side per plant (--start / --end in the markdown);
     centred blocks on narrow screens. */
  .article__body :global(.plant-figure) { margin: 6px 0 18px; }
  .article__body :global(.plant-figure img) {
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
  @media (min-width: 700px) {
    .article__body :global(.plant-figure--start) {
      float: inline-start;
      margin-inline-end: 34px;
    }
    .article__body :global(.plant-figure--end) {
      float: inline-end;
      margin-inline-start: 34px;
    }
  }
  /* plain markdown images (no figure wrapper) stay centred */
  .article__body :global(p > img) {
    display: block;
    max-width: 420px;
    width: 100%;
    height: auto;
    margin: 12px auto 8px;
  }

  .article__cta {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .article__cta p { font-size: 18px; margin: 0 0 18px; }

  @media (max-width: 767px) {
    .article__head h1 { font-size: 32px; }
    .article__body { font-size: 18px; line-height: 30px; }
    .article__body :global(h2) { font-size: 23px; }
  }
</style>
