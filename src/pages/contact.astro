---
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';

const reasons = ['פגישת ייעוץ', 'סדנת בשמים', 'סדנת גאדג\'טים למטבח', 'שאלה כללית'];
---

<Base
  title="צרו קשר"
  description="יצירת קשר עם בוטניקה — קליניקה לרפואה משלימה בחדרה. טלפון 052-8717501, אפיקי מים 1 חדרה."
>
  <section class="section">
    <div class="container contact">
      <div class="contact__form-col">
        <p class="eyebrow">צרו קשר</p>
        <h1>נשמח לשמוע מכם</h1>
        <p class="contact__lead">
          מלאו את הטופס ואחזור אליכם בהקדם, או התקשרו ישירות אליי.
        </p>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/thank-you"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hp">
            <label>אל תמלאו שדה זה: <input name="bot-field" /></label>
          </p>

          <label class="field">
            <span>שם</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>

          <label class="field">
            <span>דואר אלקטרוני</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <label class="field">
            <span>מספר טלפון</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>

          <label class="field">
            <span>סיבת הפנייה</span>
            <select name="reason" id="contact-reason">
              <option value="" disabled selected>נא לבחור את סיבת הפנייה</option>
              {reasons.map((r) => <option value={r}>{r}</option>)}
            </select>
          </label>

          <label class="field">
            <span>הודעה</span>
            <textarea name="message" rows="5" placeholder="הכניסו את פרטי ההודעה"></textarea>
          </label>

          <button type="submit" class="btn btn--block">שליחה</button>
        </form>
      </div>

      <aside class="contact__details">
        <h2>פרטי יצירת קשר</h2>
        <dl>
          <dt>כתובת</dt>
          <dd><a href={contact.mapsUrl} target="_blank" rel="noopener">{contact.address}</a></dd>
          <dt>טלפון</dt>
          <dd><a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a></dd>
          <dt>דוא״ל</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
          <dt>שעות מענה</dt>
          <dd>{contact.hours}</dd>
        </dl>
        <div class="contact__social">
          <a href={contact.instagram} target="_blank" rel="noopener">אינסטגרם</a>
          <a href={contact.facebook} target="_blank" rel="noopener">פייסבוק</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }
  .contact__lead { color: var(--ink-soft); margin-bottom: 2rem; }

  .contact-form { display: grid; gap: 1.1rem; max-width: 520px; }
  .field { display: grid; gap: 0.4rem; }
  .field > span { font-size: 0.95rem; }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 0.75em 0.9em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
  }
  .field textarea { resize: vertical; }
  .field input:focus,
  .field select:focus,
  .field textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  .hp { position: absolute; left: -9999px; }

  .contact__details {
    background: var(--bg-sand);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.2rem);
  }
  .contact__details h2 { font-size: 1.1rem; margin-bottom: 1.2rem; }
  .contact__details dl { display: grid; gap: 0.2rem; margin: 0 0 1.5rem; }
  .contact__details dt { font-size: 0.85rem; color: var(--ink-faint); margin-top: 0.9rem; }
  .contact__details dd { margin: 0; font-weight: 700; }
  .contact__social { display: flex; gap: 1rem; }
  .contact__social a { color: var(--accent); }

  @media (max-width: 820px) {
    .contact { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Pre-select the reason from ?reason= (query params don't reach a static page server-side)
  const reason = new URLSearchParams(location.search).get('reason');
  if (reason) {
    const select = document.querySelector<HTMLSelectElement>('#contact-reason');
    if (select && [...select.options].some((o) => o.value === reason)) {
      select.value = reason;
    }
  }
</script>
