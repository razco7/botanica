---
import Base from '../layouts/Base.astro';
---

<Base title="תודה שפניתם" description="ההודעה נשלחה.">
  <section class="section">
    <div class="container narrow text-center">
      <h1>תודה שפניתם 🌿</h1>
      <p class="prose">ההודעה נקלטה ואחזור אליכם בהקדם.</p>
      <div class="thanks-actions">
        <a href="/store" class="btn">לחנות</a>
        <a href="/flora-index" class="btn">למגדיר הצמחים</a>
        <a href="/" class="btn btn--ghost">לדף הבית</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 620px; margin-inline: auto; }
  .thanks-actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
