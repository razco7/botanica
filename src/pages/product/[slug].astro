---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AddToCart from '../../components/AddToCart.astro';
import { categoryLabel, site } from '../../data/site';
import { formatPrice } from '../../lib/format';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const d = product.data;
const { Content } = await render(product);

const url = `${site.url}/product/${product.id}/`;
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  description: d.summary,
  image: new URL(d.image, site.url).href,
  category: categoryLabel(d.category),
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'Offer',
    url,
    price: d.price.toFixed(2),
    priceCurrency: site.currency,
    availability: d.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: site.name },
  },
};
---

<Base title={d.name} description={d.summary} image={d.image}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <section class="section container">
    <nav class="crumbs">
      <a href="/store">החנות</a> /
      <a href={`/store/${d.category}`}>{categoryLabel(d.category)}</a> /
      <span>{d.name}</span>
    </nav>

    <div class="product">
      <div class="product__media">
        <img src={d.image} alt={d.name} width="900" height="900" />
      </div>

      <div class="product__info">
        <h1 class="product__name">{d.name}</h1>
        <p class="product__price">{formatPrice(d.price)}</p>

        <div class="prose product__desc">
          <Content />
        </div>

        {d.volume && (
          <div class="product__meta">
            <span class="dim">מכיל</span>
            <span>{d.volume}</span>
          </div>
        )}

        <div class="product__buy">
          <AddToCart product={product} />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { opacity: 0.6; font-size: 15px; margin-bottom: 2rem; }

  /* .top-section.cc-product-detail — text right, image left, centered */
  .product {
    display: flex;
    direction: rtl;
    justify-content: center;
    align-items: flex-start;
    gap: 64px;
  }

  /* .product-details-wrap */
  .product__info {
    width: 50%;
    max-width: 470px;
    padding-top: 8px;
  }

  .product__media {
    width: 50%;
    max-width: 560px;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-soft);
  }
  .product__media img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }

  /* .product-detail-name */
  .product__name { font-size: 36px; line-height: 52px; margin: 0; }
  /* .product-detail-price */
  .product__price { opacity: 0.6; font-size: 30px; line-height: 52px; margin: 0 0 20px; }

  .product__desc { margin-bottom: 30px; }

  /* .product-detail-measurement — divider + label / value row */
  .product__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-top: 1px solid var(--line-3);
    font-size: 18px;
  }

  /* .add-to-cart */
  .product__buy { margin-top: 30px; }

  @media (max-width: 991px) {
    .product { flex-direction: column; align-items: center; gap: 40px; }
    .product__info { width: 100%; max-width: 470px; text-align: center; margin-bottom: 40px; }
    .product__media { width: 100%; max-width: 520px; }
    .product__meta { justify-content: center; gap: 8px; }
  }
  @media (max-width: 479px) {
    .product__info { width: 100%; max-width: none; }
    .product__name { font-size: 30px; line-height: 40px; }
    .product__price { font-size: 26px; line-height: 40px; }
  }
</style>
