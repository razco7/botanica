---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AddToCart from '../../components/AddToCart.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryLabel } from '../../data/site';
import { formatPrice } from '../../lib/format';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, products },
  }));
}

const { product, products } = Astro.props;
const d = product.data;
const { Content } = await render(product);

const related = products
  .filter((p) => p.data.category === d.category && p.id !== product.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base title={d.name} description={d.summary} image={d.image}>
  <section class="section">
    <div class="container">
      <nav class="crumbs">
        <a href="/store">החנות</a> /
        <a href={`/store/${d.category}`}>{categoryLabel(d.category)}</a> /
        {d.name}
      </nav>

      <div class="product">
        <div class="product__media">
          <img src={d.image} alt={d.name} width="900" height="900" />
        </div>

        <div class="product__info">
          <h1>{d.name}</h1>
          <p class="product__price">{formatPrice(d.price)}</p>

          <div class="prose product__desc">
            <p>{d.summary}</p>
            <Content />
          </div>

          {d.volume && (
            <p class="product__meta"><span>מכיל</span> {d.volume}</p>
          )}

          <div class="product__buy">
            <AddToCart product={product} />
          </div>
        </div>
      </div>

      {related.length > 0 && (
        <div class="product__related">
          <h2>עוד ב{categoryLabel(d.category)}</h2>
          <div class="related-grid">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .crumbs { color: var(--ink-faint); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .crumbs a:hover { color: var(--accent); }

  .product {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }
  .product__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-soft);
    position: sticky;
    top: 100px;
  }
  .product__media img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }

  .product__price { font-size: 1.4rem; font-weight: 700; margin-bottom: 1.2rem; }
  .product__desc { margin-bottom: 1.5rem; }
  .product__meta {
    font-size: 0.95rem;
    color: var(--ink-soft);
    padding-block: 0.8rem;
    border-block: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  .product__meta span { color: var(--ink-faint); }
  .product__buy { max-width: 360px; }

  .product__related { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .product__related h2 { text-align: center; margin-bottom: 2rem; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 3vw, 2.2rem);
  }

  @media (max-width: 820px) {
    .product { grid-template-columns: 1fr; }
    .product__media { position: static; }
    .related-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
