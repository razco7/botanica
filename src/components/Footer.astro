---
import { footer, contact, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const follow = [
  { label: 'אינסטגרם', href: contact.instagram },
  { label: 'פייסבוק', href: contact.facebook },
];
---

<div class="section-footer">
  <div class="footer-divider"></div>
  <div class="container">
    <div class="footer-grid">
      <p class="footer-copy">כל הזכויות שמורות ל{site.name} — {site.tagline} {site.year}</p>

      <nav class="footer-col" aria-label={footer.columns.site}>
        <p class="footer-col__label">{footer.columns.site}</p>
        {footer.siteLinks.map((l) => (
          <a class="footer-link" href={l.href} aria-current={path === l.href.replace(/\/$/, '') ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>

      <nav class="footer-col" aria-label={footer.columns.shop}>
        <p class="footer-col__label">{footer.columns.shop}</p>
        {footer.shopLinks.map((l) => <a class="footer-link" href={l.href}>{l.label}</a>)}
      </nav>

      <nav class="footer-col" aria-label={footer.columns.help}>
        <p class="footer-col__label">{footer.columns.help}</p>
        {footer.helpLinks.map((l) => <a class="footer-link" href={l.href}>{l.label}</a>)}
      </nav>

      <nav class="footer-col" aria-label={footer.columns.follow}>
        <p class="footer-col__label">{footer.columns.follow}</p>
        {follow.map((l) => (
          <a class="footer-link" href={l.href} target="_blank" rel="noopener">{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</div>

<style>
  /* .section-footer — white band, generous top margin */
  .section-footer {
    background: #fff;
    margin-top: 124px;
  }
  .footer-divider { background: var(--line-3); height: 1px; }

  /* .footer — 5 evenly spread columns (copyright + 4 link columns) */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: 20px;
    justify-content: space-between;
    align-items: start;
    padding-block: 32px;
  }

  .footer-copy {
    margin: 0;
    opacity: var(--dim);
    font-size: 16px;
    max-width: 22ch;
  }

  .footer-col { display: flex; flex-direction: column; }
  .footer-col__label {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 700;
  }

  /* .footer-link — dimmed, brighten on hover */
  .footer-link {
    opacity: var(--dim);
    font-size: 16px;
    margin-bottom: 15px;
  }
  .footer-link:hover { opacity: 1; }
  .footer-link[aria-current='page'] { opacity: 1; }

  @media (max-width: 767px) {
    .section-footer { margin-top: 72px; }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      text-align: center;
      justify-items: center;
      gap: 28px 20px;
      padding: 28px 0;
    }
    .footer-copy { grid-column: 1 / -1; max-width: none; }
    .footer-col { align-items: center; }
  }
  @media (max-width: 479px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
