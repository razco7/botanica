---
import { nav, site, shop } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
const shopOpen = Boolean(shop.paypalClientId);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${site.name} — דף הבית`}>
      <img src="/images/site/logo.png" alt={site.name} width="88" height="136" />
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="פתיחת תפריט"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="ראשי">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {shopOpen && (
      <a href="/cart" class="cart-btn" aria-label="עגלת קניות">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L23 8H6" />
          <circle cx="10" cy="21" r="1.3" fill="currentColor" stroke="none" />
          <circle cx="18" cy="21" r="1.3" fill="currentColor" stroke="none" />
        </svg>
        <span class="cart-btn__count" data-cart-count hidden>0</span>
      </a>
    )}
  </div>
</header>

<script>
  import { subscribe, cartCount } from '../lib/cart';
  const badge = document.querySelector('[data-cart-count]');
  if (badge) {
    subscribe(() => {
      const n = cartCount();
      badge.textContent = String(n);
      (badge as HTMLElement).hidden = n === 0;
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background: #fff;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 84px;
    padding-block: 0 10px;
  }
  .site-header__logo {
    display: block;
    flex: none;
  }
  .site-header__logo img {
    width: 88px;
    height: auto;
  }
  .site-nav {
    margin-inline-start: clamp(1.5rem, 4vw, 3.5rem);
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* .navigation-item — dimmed, uppercase, tracked */
  .site-nav a {
    opacity: 0.6;
    color: var(--ink);
    text-transform: uppercase;
    font-size: 16px;
    line-height: 20px;
    padding-block: 9px;
  }
  .site-nav a:hover { opacity: 0.9; }
  .site-nav a[aria-current='page'] { opacity: 1; }

  .cart-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-inline-start: auto;
    color: var(--ink);
  }
  .cart-btn svg { width: 26px; height: 26px; }
  .cart-btn:hover { opacity: 0.7; }
  .cart-btn__count {
    position: absolute;
    inset-block-start: -2px;
    inset-inline-start: -4px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    margin-inline-start: auto;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    width: 24px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 991px) {
    .nav-toggle { display: flex; }
    .site-header__inner { flex-wrap: wrap; align-items: center; }
    .site-nav {
      flex-basis: 100%;
      margin-inline-start: 0;
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.25s ease;
      background: #fff;
    }
    .site-nav ul {
      overflow: hidden;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .site-nav li { border-top: 1px solid var(--line); }
    .site-nav a { display: block; text-align: center; padding: 15px 30px; }
    .site-nav a:hover { background: #f7f8f9; opacity: 0.9; }
    .site-header.is-open .site-nav { grid-template-rows: 1fr; }
    .site-header.is-open .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .site-header.is-open .nav-toggle span:nth-child(2) { opacity: 0; }
    .site-header.is-open .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* menu (start / right) · logo (centered) · cart (end / left) */
    .nav-toggle { order: 1; margin-inline-start: 0; }
    .site-header__logo { order: 2; margin-inline: auto; }
    .cart-btn { order: 3; margin-inline-start: 0; }
    .site-nav { order: 4; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
    toggle.setAttribute('aria-label', open ? 'סגירת תפריט' : 'פתיחת תפריט');
  });
</script>
