---
import type { CollectionEntry } from 'astro:content';

interface Props {
  plant: CollectionEntry<'flora'>;
}
const { plant } = Astro.props;
const { name, shortName, latinName, image } = plant.data;
const href = `/flora/${plant.id}`;
---

<a href={href} class="plant-card">
  <span class="plant-card__media">
    <img src={image} alt={shortName ?? name} loading="lazy" width="700" height="700" />
  </span>
  <span class="plant-card__name">{shortName ?? name}</span>
  <span class="plant-card__latin">{latinName}</span>
</a>

<style>
  /* .div-block-18 — bordered, rounded, padded card */
  .plant-card {
    display: block;
    border: 1px solid #8f8f8f;
    border-radius: 16px;
    padding: 16px;
    transition: opacity 0.2s ease;
  }
  .plant-card:hover { opacity: 0.8; }

  .plant-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .plant-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* .index-title */
  .plant-card__name {
    display: block;
    text-align: center;
    direction: rtl;
    margin-top: 12px;
    font-size: 28px;
    font-weight: 700;
    line-height: 34px;
  }
  /* .index-latin */
  .plant-card__latin {
    display: block;
    text-align: center;
    color: #5e6375;
    direction: ltr;
    font-size: 16px;
  }
</style>
