---
import type { CollectionEntry } from 'astro:content';
import { author } from '../data/site';

interface Props {
  article: CollectionEntry<'articles'>;
  headingLevel?: 'h2' | 'h3';
}
const { article, headingLevel = 'h2' } = Astro.props;
const { title, description, pubDate, image } = article.data;
const href = `/articles/${article.id}/`;
const Heading = headingLevel;
const avif = image?.replace(/\.(jpe?g|png)$/i, '.avif');
const dateLabel = pubDate.toLocaleDateString('he-IL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class:list={['article-card', { 'article-card--withimg': image }]}>
  {image && (
    <a href={href} class="article-card__media" aria-hidden="true" tabindex="-1">
      <picture>
        {avif && <source srcset={avif} type="image/avif" />}
        <img src={image} alt="" loading="lazy" width="1400" height="933" />
      </picture>
    </a>
  )}
  <div class="article-card__body">
    <Heading class="article-card__title"><a href={href}>{title}</a></Heading>
    <p class="article-card__excerpt">{description}</p>
    <p class="article-card__meta">
      מאת {author.name}
      <span class="article-card__sep">·</span>
      <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    </p>
  </div>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  /* with an image: photo on the start side (right in RTL), text fills the rest */
  .article-card--withimg {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    align-items: start;
  }

  .article-card__media {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    aspect-ratio: 3 / 2;
  }
  .article-card__media img { width: 100%; height: 100%; object-fit: cover; }

  .article-card__title {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 8px;
  }
  .article-card__title a { color: var(--ink); }
  .article-card__title a:hover { color: var(--ink-hover); }
  .article-card__excerpt {
    margin: 0 0 10px;
    font-size: 17px;
    line-height: 28px;
    color: var(--ink-soft);
  }
  .article-card__meta { margin: 0; font-size: 14px; color: var(--ink-faint); }
  .article-card__sep { margin-inline: 5px; }

  @media (max-width: 640px) {
    .article-card--withimg { grid-template-columns: 1fr; gap: 16px; }
    .article-card__title { font-size: 23px; }
  }
</style>
