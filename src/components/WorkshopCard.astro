---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  workshop: CollectionEntry<'workshops'>;
  headingLevel?: 'h2' | 'h3';
  /** compact = image on top, text below (home page); full = image beside text (workshops page) */
  variant?: 'compact' | 'full';
}
const { workshop, headingLevel = 'h2', variant = 'full' } = Astro.props;
const { title, image, signupReason } = workshop.data;
const { Content } = await render(workshop);
const Heading = headingLevel;
const signupHref = `/contact?reason=${encodeURIComponent(signupReason)}`;
---

<article class:list={['workshop-card', `workshop-card--${variant}`]}>
  <div class="workshop-card__media">
    <img src={image} alt={title} loading="lazy" width="900" height="640" />
  </div>
  <div class="workshop-card__body">
    <Heading class="h-block">{title}</Heading>
    <div class="prose workshop-card__text"><Content /></div>
    <a href={signupHref} class="btn">להרשמה לסדנא</a>
  </div>
</article>

<style>
  .workshop-card__media { border-radius: var(--radius-card); overflow: hidden; background: var(--bg-soft); }
  .workshop-card__media img { width: 100%; object-fit: cover; }
  .workshop-card__body :global(.h-block) { margin-bottom: 12px; }
  .workshop-card__text { margin-bottom: 28px; }

  /* .workshop-div — image on top, text below */
  .workshop-card--compact { text-align: right; }
  .workshop-card--compact .workshop-card__media { margin-bottom: 24px; }
  .workshop-card--compact .workshop-card__media img { aspect-ratio: 16 / 10; }

  /* .div-block-10 — image beside text, two columns */
  .workshop-card--full {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
    direction: rtl;
  }
  .workshop-card--full .workshop-card__media img { aspect-ratio: 4 / 3; }

  @media (max-width: 767px) {
    .workshop-card--full { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
