---
import type { CollectionEntry } from 'astro:content';
import { shop } from '../data/site';

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const d = product.data;
const enabled = Boolean(shop.paypalClientId);
const hasVariant = Boolean(d.variantName && d.variantOptions && d.variantOptions.length);
---

{enabled ? (
  <>
  <form class="atc" data-product-id={product.id} data-in-stock={String(d.inStock)}>
    {hasVariant && (
      <label class="atc__field">
        <span class="atc__label">{d.variantName}</span>
        <select class="atc__select" data-variant required>
          <option value="" disabled selected>{`בחרו ${d.variantName}`}</option>
          {d.variantOptions!.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
    )}

    <div class="atc__row">
      <label class="atc__field atc__field--qty">
        <span class="atc__label">כמות</span>
        <input class="atc__qty" type="number" min="1" value="1" inputmode="numeric" data-qty />
      </label>
      <button type="submit" class="btn atc__btn" disabled={!d.inStock}>
        {d.inStock ? 'הוספה לעגלה' : 'אזל מהמלאי'}
      </button>
    </div>
    <p class="atc__hint dim">התשלום דרך PayPal (גם בכרטיס אשראי). איסוף עצמי בחדרה.</p>
  </form>

  <script>
    import { addToCart } from '../lib/cart';
    document.querySelectorAll<HTMLFormElement>('form.atc').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (form.dataset.inStock !== 'true') return;
        const id = form.dataset.productId!;
        const variantEl = form.querySelector<HTMLSelectElement>('[data-variant]');
        if (variantEl && !variantEl.value) { variantEl.focus(); return; }
        const variant = variantEl?.value || undefined;
        const qtyEl = form.querySelector<HTMLInputElement>('[data-qty]')!;
        const qty = Math.max(1, parseInt(qtyEl.value) || 1);
        addToCart(id, variant, qty);
        const btn = form.querySelector<HTMLButtonElement>('.atc__btn')!;
        const original = btn.textContent;
        btn.textContent = 'נוסף לעגלה ✓';
        btn.disabled = true;
        setTimeout(() => { btn.textContent = original; btn.disabled = false; }, 1600);
      });
    });
  </script>
  </>
) : (
  <>
  <a href="/contact" class="btn atc__btn">לפרטים והזמנה — צרו קשר</a>
  <p class="atc__hint dim">התשלום המקוון ייפתח בקרוב.</p>
  </>
)}

<style>
  .atc { display: grid; gap: 18px; direction: rtl; }
  .atc__field { display: grid; gap: 8px; }
  .atc__label { font-size: 18px; line-height: 24px; }
  .atc__select {
    font: inherit;
    font-size: 18px;
    background: #fff;
    border: 1px solid var(--line-2);
    border-radius: 0;
    padding: 12px 16px;
    height: 46px;
  }
  .atc__select:focus { border-color: var(--ink-active); outline: none; }

  .atc__row { display: flex; align-items: flex-end; gap: 10px; }
  .atc__field--qty { flex: none; }
  .atc__qty {
    font: inherit;
    width: 82px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 10px 12px;
  }
  .atc__btn { flex: 1; }
  .btn[disabled] { opacity: 0.5; pointer-events: none; }
  .atc__hint { font-size: 14px; margin: 2px 0 0; }

  @media (max-width: 991px) {
    .atc__row { flex-direction: column; align-items: stretch; }
  }
</style>
