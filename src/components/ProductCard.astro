---
import type { CollectionEntry } from 'astro:content';
import { formatPrice } from '../lib/format';

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const { name, summary, price, image, inStock } = product.data;
const href = `/product/${product.id}`;
---

<article class="product-card">
  <a href={href} class="product-card__media" aria-hidden="true" tabindex="-1">
    <img src={image} alt="" loading="lazy" width="600" height="600" />
    {!inStock && <span class="product-card__badge">אזל מהמלאי</span>}
  </a>
  <div class="product-card__body">
    <h3 class="product-card__title"><a href={href}>{name}</a></h3>
    <p class="product-card__summary">{summary}</p>
    <p class="product-card__price">{formatPrice(price)}</p>
  </div>
</article>

<style>
  .product-card { display: flex; flex-direction: column; }

  /* .product-image-wrap */
  .product-card__media {
    display: block;
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg-soft);
    transition: opacity .6s ease;
  }
  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card:hover .product-card__media { opacity: 0.9; }
  .product-card__badge {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-start: 12px;
    background: var(--ink);
    color: #fff;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
  }

  .product-card__body { padding-top: 14px; direction: rtl; }

  /* .product-name-text */
  .product-card__title {
    color: #000;
    text-transform: uppercase;
    font-size: 24px;
    font-weight: 700;
    line-height: 34px;
    margin: 0 0 2px;
  }
  /* .product-desciption-text */
  .product-card__summary {
    opacity: var(--dim);
    font-size: 16px;
    line-height: 26px;
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* .product-price-text */
  .product-card__price { margin: 0; font-size: 18px; }

  @media (max-width: 479px) {
    .product-card__title { font-size: 20px; line-height: 28px; }
  }
</style>
