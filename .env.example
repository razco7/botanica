# Web3Forms access key — powers the contact form + order-notification emails.
# Get one at https://web3forms.com by confirming hello@botanicanature.com
PUBLIC_WEB3FORMS_KEY=

# PayPal REST app Client ID (cart checkout).
# developer.paypal.com -> Apps & Credentials -> your app -> Client ID.
# Sandbox key while testing, Live key at launch.
PUBLIC_PAYPAL_CLIENT_ID=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
PUBLIC_GA_ID=
